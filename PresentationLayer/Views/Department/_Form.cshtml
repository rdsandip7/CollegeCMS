@model DepartmentViewModel
<form method="post" class="card form-card">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger empty-hidden"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="DepartmentName" class="form-label"></label>
                <input asp-for="DepartmentName" class="form-control" autofocus />
                <span asp-validation-for="DepartmentName" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DepartmentHead" class="form-label"></label>
                <input asp-for="DepartmentHead" class="form-control" />
                <span asp-validation-for="DepartmentHead" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="EstablishedDate" class="form-label"></label>
                <input asp-for="EstablishedDate" class="form-control" />
                <span asp-validation-for="EstablishedDate" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-primary">@ViewData["SubmitLabel"]</button>
    </div>
</form>

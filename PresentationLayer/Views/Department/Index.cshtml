@model PagedResult<Department>
@{
    ViewData["Title"] = "Departments";
    ViewData["Subtitle"] = "Academic departments and who leads them.";
    ViewData["CreateLabel"] = "New department";
    ViewData["SearchPlaceholder"] = "Search by name, head or description";
}
<partial name="_ListHeader" />
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th sort="name">Department</th>
                    <th sort="head">Head</th>
                    <th sort="established">Established</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-medium">@item.DepartmentName</div>
                            <div class="small text-body-secondary text-truncate" style="max-width:28rem">@item.Description</div>
                        </td>
                        <td>@item.DepartmentHead</td>
                        <td class="tabular">@item.EstablishedDate?.ToString("dd MMM yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-ghost" asp-action="Edit" asp-route-id="@item.DepartmentId" title="Edit"><i class="bi bi-pencil"></i></a>
                            <partial name="_DeleteButton" model='new DeleteButtonModel("Department", item.DepartmentId.ToString(), item.DepartmentName)' />
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <partial name="_EmptyRow" model="4" />
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model" />
</div>

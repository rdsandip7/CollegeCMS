@model PagedResult<Student>
@{
    ViewData["Title"] = "Students";
    ViewData["Subtitle"] = "Admitted students and where they are in their programme.";
    ViewData["CreateLabel"] = "Admit student";
    ViewData["SearchPlaceholder"] = "Search by ID, name, email or department";
}
<partial name="_ListHeader" />
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th sort="id">Student ID</th>
                    <th sort="name">Name</th>
                    <th sort="department">Department</th>
                    <th sort="level">Level</th>
                    <th sort="admission">Admitted</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><code class="student-id">@item.StudentId</code></td>
                        <td>
                            <a class="person-link" asp-action="Details" asp-route-id="@item.StudentId">
                                <span class="avatar avatar-sm">@item.FirstName[..1]@item.LastName[..1]</span>
                                <span>
                                    <span class="fw-medium d-block">@item.FullName</span>
                                    <span class="small text-body-secondary">@item.PersonalInfo.Email</span>
                                </span>
                            </a>
                        </td>
                        <td>@item.Department?.DepartmentName</td>
                        <td class="text-nowrap">@item.Level?.DisplayName</td>
                        <td class="tabular text-nowrap">@item.PersonalInfo.AdmissionDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-ghost" asp-action="Edit" asp-route-id="@item.StudentId" title="Edit"><i class="bi bi-pencil"></i></a>
                            <partial name="_DeleteButton" model='new DeleteButtonModel("Student", item.StudentId, item.FullName)' />
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <partial name="_EmptyRow" model="6" />
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model" />
</div>

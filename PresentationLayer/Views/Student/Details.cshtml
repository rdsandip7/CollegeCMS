@using Microsoft.AspNetCore.Mvc.Rendering
@model Student
@{
    ViewData["Title"] = Model.FullName;
    var info = Model.PersonalInfo;
    var availableCourses = (IEnumerable<SelectListItem>)ViewBag.AvailableCourses;
    var totalCredits = Model.Enrollments.Sum(e => e.Course?.Credit ?? 0);
}
<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <span class="avatar avatar-lg">@Model.FirstName[..1]@Model.LastName[..1]</span>
        <div>
            <a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Students</a>
            <h1 class="h3 mb-0">@Model.FullName</h1>
            <div class="text-body-secondary"><code class="student-id">@Model.StudentId</code> · @Model.Department?.DepartmentName · @Model.Level?.DisplayName</div>
        </div>
    </div>
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.StudentId"><i class="bi bi-pencil"></i> Edit</a>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header bg-transparent"><h2 class="h6 mb-0">Personal</h2></div>
            <dl class="card-body detail-list mb-0">
                <dt>Gender</dt><dd>@(info.Gender ?? "—")</dd>
                <dt>Date of birth</dt><dd>@info.DateOfBirth.ToString("dd MMMM yyyy")</dd>
                <dt>Citizenship no.</dt><dd>@(info.CitizenshipNumber ?? "—")</dd>
                <dt>Admitted</dt><dd>@info.AdmissionDate.ToString("dd MMMM yyyy")</dd>
            </dl>
        </div>
        <div class="card mb-3">
            <div class="card-header bg-transparent"><h2 class="h6 mb-0">Contact</h2></div>
            <dl class="card-body detail-list mb-0">
                <dt>Email</dt><dd>@if (info.Email is not null) { <a href="mailto:@info.Email">@info.Email</a> } else { <text>—</text> }</dd>
                <dt>Phone</dt><dd>@(info.ContactNumber ?? "—")</dd>
                <dt>Address</dt><dd>@(info.Address ?? "—")</dd>
            </dl>
        </div>
        <div class="card">
            <div class="card-header bg-transparent"><h2 class="h6 mb-0">Guardian</h2></div>
            <dl class="card-body detail-list mb-0">
                <dt>Name</dt><dd>@(info.GuardianName ?? "—")</dd>
                <dt>Relationship</dt><dd>@(info.GuardianRelationship ?? "—")</dd>
                <dt>Phone</dt><dd>@(info.GuardianContactNumber ?? "—")</dd>
            </dl>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0">Enrolled courses</h2>
                <span class="badge bg-primary-subtle text-primary-emphasis">@Model.Enrollments.Count courses · @totalCredits credits</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th>Course</th><th class="text-end">Credits</th><th>Enrolled</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var enrollment in Model.Enrollments.OrderBy(e => e.Course?.CourseName))
                        {
                            <tr>
                                <td class="fw-medium">@enrollment.Course?.CourseName</td>
                                <td class="text-end tabular">@enrollment.Course?.Credit</td>
                                <td class="tabular">@enrollment.EnrolledDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <form asp-action="Unenroll" asp-route-id="@Model.StudentId" asp-route-enrollmentId="@enrollment.EnrollmentId" method="post"
                                          data-confirm="Remove @Model.FirstName from @enrollment.Course?.CourseName?">
                                        <button type="submit" class="btn btn-sm btn-ghost-danger" title="Remove enrollment"><i class="bi bi-x-lg"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (Model.Enrollments.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-body-secondary py-4">Not enrolled in any course yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (availableCourses.Any())
            {
                <form asp-action="Enroll" asp-route-id="@Model.StudentId" method="post" class="card-footer d-flex flex-wrap gap-2">
                    <label for="courseId" class="visually-hidden">Course</label>
                    <select id="courseId" name="courseId" class="form-select flex-grow-1" style="min-width:0;flex-basis:14rem" asp-items="availableCourses" required>
                        <option value="">Choose a course to enroll in…</option>
                    </select>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Enroll</button>
                </form>
            }
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Welcome";
}
<section class="hero">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis mb-3">Mtech College · Kathmandu</span>
            <h1 class="display-5 fw-bold mb-3">Run your college from one place.</h1>
            <p class="lead text-body-secondary mb-4">
                College CMS keeps departments, semesters, courses, students and staff together,
                with search, sorting and enrollment tracking built in.
            </p>
            <div class="d-flex flex-wrap gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-primary btn-lg" asp-action="Dashboard">Open dashboard <i class="bi bi-arrow-right"></i></a>
                }
                else
                {
                    <a class="btn btn-primary btn-lg" asp-controller="User" asp-action="Login">Sign in <i class="bi bi-arrow-right"></i></a>
                    <a class="btn btn-outline-secondary btn-lg" asp-controller="User" asp-action="Register">Create an account</a>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="feature-grid">
                <div class="feature-card"><i class="bi bi-people"></i><h3>Students</h3><p>Admissions with auto-generated IDs, guardian details and course enrollment.</p></div>
                <div class="feature-card"><i class="bi bi-person-badge"></i><h3>Employees</h3><p>Staff records with positions, hire dates and linked user accounts.</p></div>
                <div class="feature-card"><i class="bi bi-journal-bookmark"></i><h3>Courses</h3><p>Credits and duration, organised by department and semester.</p></div>
                <div class="feature-card"><i class="bi bi-shield-lock"></i><h3>Secure</h3><p>Hashed passwords, role-based access and anti-forgery protection.</p></div>
            </div>
        </div>
    </div>
</section>

<section class="about card">
    <div class="card-body p-4 p-lg-5">
        <h2 class="h4 mb-3">About Mtech College</h2>
        <p class="mb-0 text-body-secondary">
            “Mtech College” is one of the renowned colleges in Kathmandu Valley. It was established in 2000 A.D.
            and has been providing quality education ever since, which shows in the effort students put into their projects.
            The college offers four programmes: Civil Engineering, Computer Engineering and Electrical Engineering for
            students who studied Science at the intermediate level, and BSc. IT for technology enthusiasts from any
            intermediate stream.
        </p>
    </div>
</section>

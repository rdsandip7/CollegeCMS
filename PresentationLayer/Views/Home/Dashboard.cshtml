@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var s = Model.Statistics;
    var tiles = new[]
    {
        (Label: "Students", Value: s.Students, Icon: "bi-people", Controller: "Student"),
        (Label: "Employees", Value: s.Employees, Icon: "bi-person-badge", Controller: "Employee"),
        (Label: "Courses", Value: s.Courses, Icon: "bi-journal-bookmark", Controller: "Course"),
        (Label: "Departments", Value: s.Departments, Icon: "bi-building", Controller: "Department"),
        (Label: "Levels", Value: s.Levels, Icon: "bi-layers", Controller: "Level"),
        (Label: "Enrollments", Value: s.Enrollments, Icon: "bi-card-checklist", Controller: "Student"),
    };
    var maxStudents = Math.Max(1, Model.Departments.Select(d => d.Students).DefaultIfEmpty().Max());
}
<div class="page-header">
    <div>
        <h1 class="h3 mb-1">Welcome back, @User.Identity?.Name</h1>
        <p class="text-body-secondary mb-0">Here's how the college looks today.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-controller="Employee" asp-action="Create"><i class="bi bi-person-plus"></i> Add employee</a>
        <a class="btn btn-primary" asp-controller="Student" asp-action="Create"><i class="bi bi-plus-lg"></i> Admit student</a>
    </div>
</div>

<div class="row g-3 mb-4">
    @foreach (var tile in tiles)
    {
        <div class="col-6 col-md-4 col-xl-2">
            <a class="stat-tile" asp-controller="@tile.Controller" asp-action="Index">
                <i class="bi @tile.Icon"></i>
                <div class="stat-value">@tile.Value</div>
                <div class="stat-label">@tile.Label</div>
            </a>
        </div>
    }
</div>

<div class="card">
    <div class="card-header bg-transparent"><h2 class="h6 mb-0">Departments at a glance</h2></div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Department</th>
                    <th class="w-50">Students</th>
                    <th class="text-end">Employees</th>
                    <th class="text-end">Courses</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Departments)
                {
                    <tr>
                        <td class="fw-medium">@d.Department</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" role="progressbar" aria-label="@d.Department students" aria-valuenow="@d.Students" aria-valuemin="0" aria-valuemax="@maxStudents" style="height:.5rem">
                                    <div class="progress-bar" style="width:@(d.Students * 100 / maxStudents)%"></div>
                                </div>
                                <span class="tabular">@d.Students</span>
                            </div>
                        </td>
                        <td class="text-end tabular">@d.Employees</td>
                        <td class="text-end tabular">@d.Courses</td>
                    </tr>
                }
                @if (Model.Departments.Count == 0)
                {
                    <partial name="_EmptyRow" model="4" />
                }
            </tbody>
        </table>
    </div>
</div>

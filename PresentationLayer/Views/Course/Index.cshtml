@model PagedResult<Course>
@{
    ViewData["Title"] = "Courses";
    ViewData["Subtitle"] = "Every course offered, by department and semester.";
    ViewData["CreateLabel"] = "New course";
    ViewData["SearchPlaceholder"] = "Search by course, description or department";
}
<partial name="_ListHeader" />
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th sort="name">Course</th>
                    <th sort="department">Department</th>
                    <th sort="level">Level</th>
                    <th sort="duration">Duration</th>
                    <th sort="credit" class="text-end">Credits</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-medium">@item.CourseName</div>
                            <div class="small text-body-secondary text-truncate" style="max-width:24rem">@item.Description</div>
                        </td>
                        <td><span class="badge text-bg-light border">@item.Department?.DepartmentName</span></td>
                        <td class="text-nowrap">@item.Level?.DisplayName</td>
                        <td>@item.Duration</td>
                        <td class="text-end tabular">@item.Credit</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-ghost" asp-action="Edit" asp-route-id="@item.CourseId" title="Edit"><i class="bi bi-pencil"></i></a>
                            <partial name="_DeleteButton" model='new DeleteButtonModel("Course", item.CourseId.ToString(), item.CourseName)' />
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <partial name="_EmptyRow" model="6" />
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model" />
</div>

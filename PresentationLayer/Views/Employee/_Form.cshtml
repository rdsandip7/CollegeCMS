@model EmployeeViewModel
<form method="post" class="card form-card">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger empty-hidden"></div>

        <h2 class="form-section">Basic details</h2>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" autofocus />
                <span asp-validation-for="FirstName" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="MiddleName" class="form-label"></label>
                <input asp-for="MiddleName" class="form-control" />
                <span asp-validation-for="MiddleName" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Gender" class="form-label"></label>
                <select asp-for="Gender" class="form-select">
                    <option value="">Prefer not to say</option>
                    <option>Female</option>
                    <option>Male</option>
                    <option>Other</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="invalid-feedback d-block"></span>
            </div>
        </div>

        <h2 class="form-section">Employment</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="DepartmentId" class="form-label"></label>
                <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
                    <option value="">Choose a department…</option>
                </select>
                <span asp-validation-for="DepartmentId" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Position" class="form-label"></label>
                <input asp-for="Position" class="form-control" placeholder="e.g. Lecturer" />
                <span asp-validation-for="Position" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="HiredDate" class="form-label"></label>
                <input asp-for="HiredDate" class="form-control" />
                <span asp-validation-for="HiredDate" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ResignationDate" class="form-label"></label>
                <input asp-for="ResignationDate" class="form-control" />
                <div class="form-text">Leave empty while the employee is still working here.</div>
                <span asp-validation-for="ResignationDate" class="invalid-feedback d-block"></span>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-primary">@ViewData["SubmitLabel"]</button>
    </div>
</form>

@model PagedResult<Employee>
@{
    ViewData["Title"] = "Employees";
    ViewData["Subtitle"] = "Teaching and administrative staff.";
    ViewData["CreateLabel"] = "New employee";
    ViewData["SearchPlaceholder"] = "Search by name, email, department or position";
}
<partial name="_ListHeader" />
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th sort="name">Name</th>
                    <th sort="email">Email</th>
                    <th sort="department">Department</th>
                    <th sort="position">Position</th>
                    <th sort="hired">Hired</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <a class="person-link" asp-action="Details" asp-route-id="@item.EmployeeId">
                                <span class="avatar avatar-sm">@item.FirstName[..1]@item.LastName[..1]</span>
                                <span class="fw-medium">@item.FullName</span>
                            </a>
                        </td>
                        <td><a href="mailto:@item.Email" class="text-reset">@item.Email</a></td>
                        <td>@item.Department?.DepartmentName</td>
                        <td>@item.PersonalInfo.Position</td>
                        <td class="tabular text-nowrap">@item.PersonalInfo.HiredDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item.PersonalInfo.ResignationDate is null)
                            {
                                <span class="badge rounded-pill bg-success-subtle text-success-emphasis">Active</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis">Left @item.PersonalInfo.ResignationDate?.ToString("MMM yyyy")</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-ghost" asp-action="Edit" asp-route-id="@item.EmployeeId" title="Edit"><i class="bi bi-pencil"></i></a>
                            <partial name="_DeleteButton" model='new DeleteButtonModel("Employee", item.EmployeeId.ToString(), item.FullName)' />
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <partial name="_EmptyRow" model="7" />
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model" />
</div>

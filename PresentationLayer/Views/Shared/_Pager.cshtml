@model IPagedResult
@{
    var search = ViewData["Search"] as string;
    var sort = ViewData["Sort"] as string;
    var first = Model.TotalCount == 0 ? 0 : (Model.PageNumber - 1) * Model.PageSize + 1;
    var last = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);

    // First, last and two pages either side of the current one; gaps become an ellipsis.
    var pages = Enumerable.Range(1, Model.PageCount)
        .Where(p => p == 1 || p == Model.PageCount || Math.Abs(p - Model.PageNumber) <= 2)
        .ToList();
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-top">
    <small class="text-body-secondary">Showing @first.ToString("N0")–@last.ToString("N0") of @Model.TotalCount.ToString("N0")</small>
    @if (Model.PageCount > 1)
    {
        <nav aria-label="Pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-route-page="@(Model.PageNumber - 1)" asp-route-search="@search" asp-route-sort="@sort" aria-label="Previous">&laquo;</a>
                </li>
                @for (var i = 0; i < pages.Count; i++)
                {
                    if (i > 0 && pages[i] - pages[i - 1] > 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item @(pages[i] == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-route-page="@pages[i]" asp-route-search="@search" asp-route-sort="@sort">@pages[i]</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-route-page="@(Model.PageNumber + 1)" asp-route-search="@search" asp-route-sort="@sort" aria-label="Next">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>

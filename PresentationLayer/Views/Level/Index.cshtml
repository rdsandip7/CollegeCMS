@model PagedResult<Level>
@{
    ViewData["Title"] = "Levels";
    ViewData["Subtitle"] = "Academic years and semesters.";
    ViewData["CreateLabel"] = "New level";
    ViewData["SearchPlaceholder"] = "Search by year, semester or description";
}
<partial name="_ListHeader" />
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th sort="year">Year</th>
                    <th sort="semester">Semester</th>
                    <th sort="description">Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="tabular fw-medium">@item.Year</td>
                        <td>@item.Semester</td>
                        <td class="text-body-secondary">@item.Description</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-ghost" asp-action="Edit" asp-route-id="@item.LevelId" title="Edit"><i class="bi bi-pencil"></i></a>
                            <partial name="_DeleteButton" model='new DeleteButtonModel("Level", item.LevelId.ToString(), item.DisplayName)' />
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <partial name="_EmptyRow" model="4" />
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model" />
</div>
